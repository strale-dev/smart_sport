# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Supabase CLI (one-time setup for npm run db:link / db:push / db:types)
# Generate at https://supabase.com/dashboard/account/tokens
# SUPABASE_ACCESS_TOKEN=sbp_...
# Database password from Project Settings → Database (prompted by db:link if omitted)
# SUPABASE_DB_PASSWORD=your_database_password

# Redis (Upstash) — required for distributed cache in dev/prod
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# API-Football — optional until live smoke / cache+cron (Free key OK for development ingestion)
# Vercel Production values & Pro cutover: docs/ING-3-pro-cutover.md
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
# Match limit to key tier: Free = 100, Pro = 7500
API_FOOTBALL_DAILY_LIMIT=100
# When true (default in development), UI reads Postgres only — no on-demand provider calls
API_FOOTBALL_INGEST_ONLY=true
# Lineups sync gate (Vercel cron hits /api/cron/sync-lineups every 15m; body respects this flag)
# unset + development → off; unset + production → on; true → on; false → off (Production kill-switch before Pro)
# API_FOOTBALL_LINEUPS_SYNC_ENABLED=true
# Max NS/TBD fixtures processed per sync-lineups run (default 30)
# LINEUPS_SYNC_BATCH=30
# Enable presence-gated live polling (requires Pro key + Redis). Set on Vercel Production too.
LIVE_POLLING_ENABLED=true

# Vercel Cron auth (Vercel sends Authorization: Bearer <CRON_SECRET> automatically)
CRON_SECRET=

# OpenAI — optional until phase4:ai-smoke / live AI generation
OPENAI_API_KEY=
OPENAI_MODEL_DEFAULT=gpt-4o-mini
FREE_TIER_AI_PREDICTIONS_PER_DAY=5
AI_PREMATCH_CACHE_TTL_SEC=86400
AI_PROMPT_VERSION=1.0.0

# Resend (also used as Supabase Auth SMTP — see npm run auth:configure-supabase)
RESEND_API_KEY=re_your_api_key
RESEND_FROM="Scorence <hello@scorence.app>"

# Supabase Management API (optional — for npm run auth:configure-supabase)
# Create at https://supabase.com/dashboard/account/tokens
# SUPABASE_ACCESS_TOKEN=sbp_...

# Google OAuth (Supabase Auth → Authentication → Providers)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Sentry
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_ORG=scorence
SENTRY_PROJECT=javascript-nextjs
# Optional — source map upload in CI/Vercel builds
# SENTRY_AUTH_TOKEN=

# App (production: https://scorence.app — use http://localhost:3000 only for isolated local UI work)
NEXT_PUBLIC_SITE_URL=https://scorence.app
NEXT_PUBLIC_APP_ENV=development
# Vercel Production also set: LIVE_POLLING_ENABLED=true, CRON_SECRET, NEXT_PUBLIC_APP_ENV=production, API_FOOTBALL_INGEST_ONLY=false
