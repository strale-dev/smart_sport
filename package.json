    "ui-p3:check": "node scripts/ui-p3-lighthouse-check.mjs && vitest run lib/match/scoreboard-presets.test.ts",
    "ui-p4:check": "vitest run lib/match/scoreboard-presets.test.ts components/match/MatchMetaBar.test.tsx",
    "e2e": "playwright test",
    "e2e:match": "playwright test e2e/match-page.spec.ts",
    "e2e:auth-setup": "playwright test --project=setup",
    "e2e:quality": "node scripts/run-playwright-quality.mjs",
    "phase7:check": "node scripts/phase7-dod-check.mjs",
    "phase7:check:full": "node scripts/phase7-dod-check.mjs --full",
    "quality:lighthouse": "node scripts/quality-lighthouse-check.mjs",
    "quality:axe": "playwright test e2e/a11y-critical.spec.ts --project=chromium",
    "quality:prd-audit": "node scripts/quality-prd-audit.mjs",
    "quality:k6": "node scripts/k6/run-k6.mjs",
    "phase5:check": "node scripts/phase5-dod-check.mjs",
    "phase5:match-smoke": "tsx ./scripts/phase5-match-smoke.ts",
    "phase5:live-center-smoke": "tsx ./scripts/phase5-live-center-smoke.ts",
    "phase6:check": "node scripts/phase6-dod-check.mjs",
    "phase6:webhook-smoke": "tsx ./scripts/phase6-webhook-smoke.ts",
    "phase6:entitlements-smoke": "tsx ./scripts/phase6-entitlements-smoke.ts",
    "phase6:follow-smoke": "tsx --import ./scripts/preload-env.ts ./scripts/phase6-follow-smoke.ts",
    "quota:smoke": "tsx --import ./scripts/preload-env.ts ./scripts/quota-smoke.ts",
    "auth:configure-supabase": "tsx --import ./scripts/preload-env.ts ./scripts/configure-supabase-auth.ts",
    "auth:push-config": "supabase config push --yes"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
