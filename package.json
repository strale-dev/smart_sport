{
  "name": "scorence",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ci": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "db:login": "supabase login",
    "db:link": "supabase link --project-ref zovobemlpqoclyjhvkpw --yes",
    "db:status": "supabase migration list --linked",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --linked --schema public > types/supabase.ts",
    "db:diff": "supabase db diff --linked",
    "db:verify-migrations": "node scripts/verify-supabase-migrations.mjs",
    "phase0:check": "node scripts/phase0-dod-check.mjs",
    "phase1:check": "node scripts/phase1-dod-check.mjs",
    "phase2:check": "node scripts/phase2-dod-check.mjs",
    "phase2:dashboard-smoke": "tsx --import ./scripts/preload-env.ts ./scripts/phase2-dashboard-smoke.ts",
    "phase2:fixtures-smoke": "tsx --import ./scripts/preload-env.ts ./scripts/phase2-fixtures-smoke.ts",
    "api-football:smoke": "tsx --import ./scripts/preload-env.ts ./scripts/api-football-smoke.ts",
    "bootstrap:static-data": "tsx --import ./scripts/preload-env.ts ./scripts/bootstrap-static-data.ts",
    "sync:fixtures": "tsx --import ./scripts/preload-env.ts ./scripts/run-sync-fixtures.ts",
    "sync:standings": "tsx --import ./scripts/preload-env.ts ./scripts/run-sync-standings.ts",
    "sync:match-details": "tsx --import ./scripts/preload-env.ts ./scripts/run-sync-match-details.ts",
    "bootstrap:match-details": "tsx --import ./scripts/preload-env.ts ./scripts/bootstrap-match-details.ts",
    "verify:ingestion": "tsx --import ./scripts/preload-env.ts ./scripts/verify-ingestion.ts",
    "cache:smoke": "tsx --import ./scripts/preload-env.ts ./scripts/cache-smoke.ts",
    "quota:smoke": "tsx --import ./scripts/preload-env.ts ./scripts/quota-smoke.ts",
    "auth:configure-supabase": "tsx --import ./scripts/preload-env.ts ./scripts/configure-supabase-auth.ts",
    "auth:push-config": "supabase config push --yes"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.9.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@sentry/nextjs": "^10.72.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "motion": "^13.1.1",
    "next": "16.3.3",
    "p-retry": "^8.0.0",
    "posthog-js": "^1.422.4",
    "posthog-node": "^5.51.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-email": "^6.9.3",
    "react-hook-form": "^7.86.0",
    "recharts": "^3.10.1",
    "resend": "^6.24.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.11.10",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.19.0",
    "supabase": "^2.116.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
